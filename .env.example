# Neon PostgreSQL connection strings
# Direct connection (used for migrations and administrative tasks)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
# Pooled connection (used for application queries)
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/neondb?sslmode=require"

# Better Auth configuration
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
